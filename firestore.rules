rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ── USERS COLLECTION ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        resource.data.email == request.auth.token.email ||
        userId == request.auth.token.email ||
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      
      allow create: if isSignedIn() && 
        request.auth.uid == userId && 
        request.resource.data.role == 'student' && 
        request.resource.data.isApproved == false;
      
      allow update: if isSignedIn() && (
        // Student can update their own profile basic info
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isApproved', 'roomNumber', 'hostel'])) ||
        // Warden can approve students (but absolutely cannot change their role, uid, or email)
        (getUserRole() == 'warden' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email'])) ||
        // Head Warden & Chief Warden admin
        (getUserRole() == 'headWarden' || getUserRole() == 'chiefWarden')
      );
      
      // Face embeddings: only owner or warden can access
      allow get: if isSignedIn() && (request.auth.uid == userId || getUserRole() == 'warden' || getUserRole() == 'headWarden' || getUserRole() == 'chiefWarden');
      
      // Allow deletion of pre-populated email-based profiles during migration
      allow delete: if isSignedIn() && (request.auth.uid == userId || userId == request.auth.token.email);
    }

    // ── ATTENDANCE ───────────────────────────────────────────────────────────
    match /attendance/{id} {
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
    }

    // ── LEAVE REQUESTS ───────────────────────────────────────────────────────
    match /leave_requests/{id} {
      allow create: if isSignedIn() && 
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'Pending' &&
        !request.resource.data.keys().hasAny(['approvedBy', 'rejectedBy', 'actualCheckOutTime', 'checkInTime']);
        
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      allow update: if isSignedIn() && (
        (resource.data.studentId == request.auth.uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'Cancelled') || 
          (resource.data.status == 'Pending' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'studentId', 'approvedBy', 'rejectedBy', 'checkInTime'])) ||
          (resource.data.status == 'Approved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkInTime']))
        )) ||
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
    }

    // ── COMPLAINTS ───────────────────────────────────────────────────────────
    match /complaints/{id} {
      allow create: if isSignedIn() && 
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'Pending' &&
        !request.resource.data.keys().hasAny(['resolvedBy', 'remarks', 'resolvedAt']);
        
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      allow update: if isSignedIn() && (
        (resource.data.studentId == request.auth.uid && (
          (resource.data.status == 'Pending' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'studentId', 'resolvedBy', 'remarks', 'resolvedAt'])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'studentConfirmed']) && request.resource.data.status == 'Confirmed') ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isEscalated', 'studentConfirmed', 'targetRole', 'targetRoles']) && request.resource.data.isEscalated == true)
        )) ||
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
    }

    // ── COUNTERS ─────────────────────────────────────────────────────────────
    match /counters/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.current == 1;
      allow update: if isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current']) &&
        request.resource.data.current == resource.data.current + 1;
      allow delete: if false; // Only admins via Firebase Console can delete
    }

    // ── PHONE MAPPINGS (Secure Lookup) ───────────────────────────────────────
    match /phone_mappings/{phone} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn() && 
        (!exists(/databases/$(database)/documents/phone_mappings/$(phone)) || 
         resource.data.email == request.auth.token.email) &&
        request.resource.data.email == request.auth.token.email;
    }

    // ── SHORT STAY REQUESTS ──────────────────────────────────────────────────
    match /short_stay_requests/{id} {
      allow create: if isSignedIn() && 
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'Pending' &&
        !request.resource.data.keys().hasAny(['approvedBy', 'rejectedBy', 'actualCheckOutTime']);
        
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      allow update: if isSignedIn() && (
        (resource.data.studentId == request.auth.uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'Cancelled') || 
          (resource.data.status == 'Pending' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'studentId', 'approvedBy', 'rejectedBy', 'actualCheckOutTime'])) ||
          (resource.data.status == 'Approved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'actualCheckOutTime']) && request.resource.data.status == 'Completed')
        )) ||
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
    }
  }
}
