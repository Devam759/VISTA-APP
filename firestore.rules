rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads role from Firestore once per rule evaluation (cached by backend).
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isWarden() {
      return getUserRole() == 'warden';
    }

    function isHeadWarden() {
      return getUserRole() == 'headWarden';
    }

    function isChiefWarden() {
      return getUserRole() == 'chiefWarden';
    }

    function isStaff() {
      return isWarden() || isHeadWarden() || isChiefWarden();
    }

    // True only when a Cloud Function or admin SDK is calling
    // (firebase-admin sets admin = true in the auth token).
    function isAdminCaller() {
      return request.auth.token.get('admin', false) == true;
    }

    // ── Valid status whitelists ────────────────────────────────────────────
    function validLeaveStatus() {
      return request.resource.data.status in
        ['Pending', 'Approved', 'Rejected', 'Cancelled'];
    }

    function validShortStayStatus() {
      return request.resource.data.status in
        ['Pending', 'Approved', 'Rejected', 'Cancelled', 'Completed'];
    }

    function validComplaintStatus() {
      return request.resource.data.status in
        ['Pending', 'Resolved', 'Confirmed', 'Escalated'];
    }

    // ── USERS ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Read: own doc, or any staff member.
      allow read: if isSignedIn() && (
        uid() == userId ||
        resource.data.email == request.auth.token.email ||
        userId == request.auth.token.email ||
        isStaff()
      );

      // Create: only the user themselves, as a student.
      // Day Scholars (isDayScholar == true) may self-approve; hostellers must start unapproved.
      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.role == 'student'
        && (request.resource.data.isApproved == false
            || (request.resource.data.isApproved == true
                && request.resource.data.isDayScholar == true))
        // Block injection of privileged fields at creation time.
        && !request.resource.data.keys().hasAny(['fcmToken', 'hasUsedShortStay']);
      allow update: if isSignedIn() && (
        // Student updates own non-sensitive fields only.
        (uid() == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isApproved', 'roomNumber', 'hostel',
                        'uid', 'email', 'hasUsedShortStay', 'createdAt'])
        ) ||
        // Warden can approve/assign room but cannot touch role or uid or email.
        (isWarden()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'uid', 'email'])
        ) ||
        // Head/Chief wardens have full update rights (still cannot change role).
        (isHeadWarden() || isChiefWarden())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
      );

      // Face embeddings: only owner or staff.
      allow get: if isSignedIn() && (uid() == userId || isStaff());
    }

    // ── ATTENDANCE ─────────────────────────────────────────────────────────
    match /attendance/{id} {
      allow create: if isSignedIn()
        && request.resource.data.studentId == uid()
        // Enforce valid status value on creation.
        && request.resource.data.status in ['Present', 'Absent', 'Late']
        // Timestamp must equal server-request time (within 60 seconds tolerance
        // accepted by Firestore; client cannot forge a timestamp in the past).
        && request.resource.data.timestamp == request.time;

      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        isStaff()
      );

      // Attendance records are immutable once written — no updates allowed.
      allow update, delete: if false;
    }

    // ── LEAVE REQUESTS ─────────────────────────────────────────────────────
    match /leave_requests/{id} {
      allow create: if isSignedIn()
        && request.resource.data.studentId == uid()
        && request.resource.data.status == 'Pending'
        // Block privilege fields from being injected at creation.
        && !request.resource.data.keys()
            .hasAny(['approvedBy', 'rejectedBy', 'actualCheckOutTime', 'checkInTime']);

      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        isStaff()
      );

      allow update: if isSignedIn() && (
        // Student can cancel their own pending leave, or update while Pending,
        // or mark check-in on an Approved leave.
        (resource.data.studentId == uid() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'Cancelled') ||
          (resource.data.status == 'Pending'
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['status', 'studentId', 'approvedBy', 'rejectedBy', 'checkInTime'])) ||
          (resource.data.status == 'Approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkInTime']))
        )) ||
        // Staff can update but must keep status in the whitelist.
        (isStaff() && validLeaveStatus())
      );

      allow delete: if false;
    }

    // ── COMPLAINTS ─────────────────────────────────────────────────────────
    match /complaints/{id} {
      allow create: if isSignedIn()
        && request.resource.data.studentId == uid()
        && request.resource.data.status == 'Pending'
        // Students cannot pre-set resolution or escalation fields.
        && !request.resource.data.keys()
            .hasAny(['resolvedBy', 'remarks', 'resolvedAt', 'isEscalated'])
        && validComplaintStatus();

      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        isStaff()
      );

      allow update: if isSignedIn() && (
        // Student may: edit while Pending, confirm resolution, or escalate.
        (resource.data.studentId == uid() && (
          // 1. Edit basic info while pending
          (resource.data.status == 'Pending'
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['status', 'studentId', 'resolvedBy', 'remarks',
                          'resolvedAt', 'isEscalated', 'targetRole', 'targetRoles'])) ||
          // 2. Confirm resolution
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'studentConfirmed'])
            && request.resource.data.status == 'Confirmed') ||
          // 3. Escalate (move to next authority)
          (request.resource.data.isEscalated == true
            && request.resource.data.status == 'Pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'isEscalated', 'studentConfirmed',
                          'targetRole', 'targetRoles', 'resolvedAt']))
        )) ||
        // Staff can update including escalation, but must use valid status.
        (isStaff() && validComplaintStatus())
      );

      allow delete: if false;
    }

    // ── COUNTERS ───────────────────────────────────────────────────────────
    // Sequence counters must only be written by Cloud Functions (admin SDK).
    // Clients have read access so they can display sequence IDs after creation.
    match /counters/{id} {
      allow read: if isSignedIn();
      // Only admin callers (Cloud Functions) may write counters.
      allow write: if isAdminCaller();
    }

    // ── PHONE MAPPINGS ─────────────────────────────────────────────────────
    // FIX: was `allow get: if true` — anyone could enumerate emails by phone.
    // Now requires authentication.
    match /phone_mappings/{phone} {
      allow get: if isSignedIn();     // ← was: if true (unauthenticated PII leak)
      allow list: if false;           // no enumeration ever
      allow write: if isSignedIn()
        && (!exists(/databases/$(database)/documents/phone_mappings/$(phone))
          || resource.data.email == request.auth.token.email)
        && request.resource.data.email == request.auth.token.email;
    }

    // ── SHORT STAY REQUESTS ───────────────────────────────────────────────
    match /short_stay_requests/{id} {
      allow create: if isSignedIn()
        && request.resource.data.studentId == uid()
        && request.resource.data.status == 'Pending'
        && !request.resource.data.keys()
            .hasAny(['approvedBy', 'rejectedBy', 'actualCheckOutTime'])
        && validShortStayStatus();

      allow read: if isSignedIn() && (
        resource.data.studentId == uid() ||
        isStaff()
      );

      allow update: if isSignedIn() && (
        (resource.data.studentId == uid() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'Cancelled') ||
          (resource.data.status == 'Pending'
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['status', 'studentId', 'approvedBy', 'rejectedBy', 'actualCheckOutTime'])) ||
          (resource.data.status == 'Approved' && (
            // 1. Mark as completed/check-out
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'actualCheckOutTime'])
              && request.resource.data.status == 'Completed') ||
            // 2. Request extension (move back to Pending for warden review)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingToDate', 'status'])
              && request.resource.data.status == 'Pending')
          ))
        )) ||
        (isStaff() && validShortStayStatus())
      );

      allow delete: if false;
    }

    // ── NOTIFICATIONS ──────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.studentId == uid());
      allow create: if isSignedIn() && isStaff();
      allow update: if isSignedIn() && resource.data.studentId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // ── AUDIT LOGS ────────────────────────────────────────────────────────
    // Append-only security event log.
    // Only the client can create (its own events), only chief warden can read.
    // Nobody can update or delete.
    match /audit_logs/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasAll(['uid', 'event', 'timestamp']);
      allow read: if isSignedIn() && isChiefWarden();
      allow update, delete: if false;
    }
  }
}
