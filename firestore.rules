rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ── USERS COLLECTION ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        // Student can update their own profile basic info
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isApproved', 'roomNumber'])) ||
        // Warden can approve students
        (getUserRole() == 'warden' && request.resource.data.diff(resource.data).affectedKeys().hasAny(['isApproved', 'roomNumber'])) ||
        // Head Warden & Chief Warden admin
        (getUserRole() == 'headWarden' || getUserRole() == 'chiefWarden')
      );
      
      // Face embeddings: only owner or warden can access
      allow get: if isSignedIn() && (request.auth.uid == userId || getUserRole() == 'warden' || getUserRole() == 'headWarden' || getUserRole() == 'chiefWarden');
    }

    // ── ATTENDANCE ───────────────────────────────────────────────────────────
    match /attendance/{id} {
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
    }

    // ── LEAVE REQUESTS ───────────────────────────────────────────────────────
    match /leave_requests/{id} {
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      allow update: if isSignedIn() && (
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden' ||
        (resource.data.studentId == request.auth.uid && (
          request.resource.data.status == 'Cancelled' || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkInTime'])
        ))
      );
    }

    // ── COMPLAINTS ───────────────────────────────────────────────────────────
    match /complaints/{id} {
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      allow update: if isSignedIn() && (
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden' ||
        resource.data.studentId == request.auth.uid
      );
    }

    // ── COUNTERS ─────────────────────────────────────────────────────────────
    match /counters/{id} {
      allow read, write: if isSignedIn();
    }

    // ── PHONE MAPPINGS (Secure Lookup) ───────────────────────────────────────
    match /phone_mappings/{phone} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn();
    }

    // ── SHORT STAY REQUESTS ──────────────────────────────────────────────────
    match /short_stay_requests/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden'
      );
      allow update: if isSignedIn() && (
        getUserRole() == 'warden' || 
        getUserRole() == 'headWarden' ||
        getUserRole() == 'chiefWarden' ||
        resource.data.studentId == request.auth.uid
      );
    }
  }
}
